  LTEXT "Microphone", IDC_SITE_MICROPHONE_LABEL, 14, 84, 90, 10
  COMBOBOX IDC_SITE_MICROPHONE, 110, 82, 196, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
  LTEXT "Location", IDC_SITE_LOCATION_LABEL, 14, 106, 90, 10
  COMBOBOX IDC_SITE_LOCATION, 110, 104, 196, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
  LTEXT "Notifications", IDC_SITE_NOTIFICATIONS_LABEL, 14, 128, 90, 10
  COMBOBOX IDC_SITE_NOTIFICATIONS, 110, 126, 196, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL

  AUTOCHECKBOX "Block ads and trackers on this site", IDC_SITE_AD_FILTERING, 14, 156, 292, 10
  AUTOCHECKBOX "Allow cookies and site data", IDC_SITE_COOKIES, 14, 172, 292, 10
  AUTOCHECKBOX "Allow plain HTTP on this site", IDC_SITE_ALLOW_PLAIN_HTTP, 14, 188, 292, 10
