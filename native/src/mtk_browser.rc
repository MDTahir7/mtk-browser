#include <windows.h>
#include "resource.h"

IDI_MTK_BROWSER ICON "../resources/mtk_browser.ico"

IDD_TAB_SEARCH DIALOGEX 0, 0, 440, 260
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search tabs"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Search titles or addresses in this window", IDC_TAB_SEARCH_LABEL, 14, 10, 412, 16
  EDITTEXT IDC_TAB_SEARCH_QUERY, 14, 30, 412, 18, ES_AUTOHSCROLL
  LISTBOX IDC_TAB_SEARCH_LIST, 14, 56, 412, 152, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
  LTEXT "", IDC_TAB_SEARCH_EMPTY, 14, 212, 236, 16
  DEFPUSHBUTTON "Switch to tab", IDOK, 256, 230, 90, 20
  PUSHBUTTON "Cancel", IDCANCEL, 354, 230, 72, 20
END

IDD_TASK_MANAGER DIALOGEX 0, 0, 620, 320
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Browser task manager"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Live CPU and memory use from browser processes. The list refreshes every second.", IDC_TASK_MANAGER_HINT, 14, 10, 592, 16
  CONTROL "", IDC_TASK_MANAGER_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_VSCROLL | WS_HSCROLL, 14, 28, 592, 252
  PUSHBUTTON "End process", IDC_TASK_MANAGER_END_PROCESS, 14, 288, 96, 22
  PUSHBUTTON "Refresh", IDC_TASK_MANAGER_REFRESH, 426, 288, 84, 22
  PUSHBUTTON "Close", IDCANCEL, 522, 288, 84, 22
END

IDD_READING_LIST DIALOGEX 0, 0, 440, 260
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Reading list"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Saved articles stay on this device. Open one to read it later.", IDC_READING_LIST_HINT, 14, 10, 412, 18
  LISTBOX IDC_READING_LIST_LIST, 14, 34, 412, 164, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "Remove", IDC_READING_LIST_REMOVE, 14, 218, 76, 20
  DEFPUSHBUTTON "Open", IDC_READING_LIST_OPEN, 256, 218, 90, 20
  PUSHBUTTON "Close", IDCANCEL, 354, 218, 72, 20
END

IDD_WEB_APPS DIALOGEX 0, 0, 440, 260
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Installed web apps"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Web apps run in dedicated windows with isolated profiles.", IDC_WEB_APPS_HINT, 14, 10, 412, 18
  LISTBOX IDC_WEB_APPS_LIST, 14, 34, 412, 164, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "Uninstall", IDC_WEB_APPS_REMOVE, 14, 218, 76, 20
  PUSHBUTTON "Add to Desktop", IDC_WEB_APPS_DESKTOP, 96, 218, 90, 20
  DEFPUSHBUTTON "Open", IDC_WEB_APPS_OPEN, 256, 218, 90, 20
  PUSHBUTTON "Close", IDCANCEL, 354, 218, 72, 20
END

IDD_INSTALL_WEB_APP DIALOGEX 0, 0, 310, 160
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Install web app"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Install this site as a dedicated desktop web app?", IDC_INSTALL_APP_LABEL, 14, 12, 282, 14
  LTEXT "App name", IDC_INSTALL_APP_NAME_LABEL, 14, 30, 282, 10
  EDITTEXT IDC_INSTALL_APP_NAME, 14, 42, 282, 14, ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "", IDC_INSTALL_APP_URL, 14, 62, 282, 12
  AUTOCHECKBOX "Create Desktop shortcut", IDC_INSTALL_DESKTOP_SHORTCUT, 14, 80, 282, 12
  AUTOCHECKBOX "Add to Start Menu", IDC_INSTALL_START_MENU, 14, 96, 282, 12
  DEFPUSHBUTTON "Install", IDOK, 164, 128, 64, 18
  PUSHBUTTON "Cancel", IDCANCEL, 234, 128, 62, 18
END

IDD_BOOKMARK_EDITOR DIALOGEX 0, 0, 330, 144
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit bookmark"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Name", IDC_BOOKMARK_NAME_LABEL, 14, 12, 302, 16
  EDITTEXT IDC_BOOKMARK_NAME, 14, 30, 302, 16, ES_AUTOHSCROLL
  LTEXT "Folder", IDC_BOOKMARK_FOLDER_LABEL, 14, 54, 302, 16
  COMBOBOX IDC_BOOKMARK_FOLDER, 14, 72, 302, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "Remove bookmark", IDC_BOOKMARK_REMOVE, 14, 112, 108, 20
  DEFPUSHBUTTON "Save", IDOK, 166, 112, 70, 20
  PUSHBUTTON "Cancel", IDCANCEL, 244, 112, 72, 20
END

// Per-monitor DPI awareness and modern common controls.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "mtk_browser.manifest"

IDD_PIN_PROMPT DIALOGEX 0, 0, 268, 96
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Parent PIN — MTK Browser"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "", IDC_PIN_PROMPT_TEXT, 14, 12, 240, 20
  LTEXT "Parent PIN", IDC_PIN_PROMPT_LABEL, 14, 40, 240, 10
  EDITTEXT IDC_PIN_PROMPT_VALUE, 14, 53, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL
  DEFPUSHBUTTON "Unlock", IDOK, 118, 76, 66, 14
  PUSHBUTTON "Cancel", IDCANCEL, 188, 76, 66, 14
END

IDD_PIN_SETUP DIALOGEX 0, 0, 268, 168
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Parent PIN — MTK Browser"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "A parent PIN stops safety settings from being changed by someone else. Use at least 4 characters.", IDC_PIN_SETUP_INTRO, 14, 10, 240, 26
  LTEXT "Current PIN", IDC_PIN_SETUP_CURRENT_LABEL, 14, 42, 240, 10
  EDITTEXT IDC_PIN_SETUP_CURRENT, 14, 55, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL
  LTEXT "New PIN", IDC_PIN_SETUP_NEW_LABEL, 14, 76, 240, 10
  EDITTEXT IDC_PIN_SETUP_NEW, 14, 89, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL
  LTEXT "Confirm new PIN", IDC_PIN_SETUP_CONFIRM_LABEL, 14, 110, 240, 10
  EDITTEXT IDC_PIN_SETUP_CONFIRM, 14, 123, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL
  PUSHBUTTON "Remove PIN", IDC_PIN_SETUP_REMOVE, 14, 146, 76, 14
  DEFPUSHBUTTON "Save PIN", IDOK, 118, 146, 66, 14
  PUSHBUTTON "Cancel", IDCANCEL, 188, 146, 66, 14
END

IDD_CLEAR_DATA DIALOGEX 0, 0, 300, 224
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Clear browsing data — MTK Browser"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Choose what to remove from this computer. This cannot be undone.", IDC_CLEAR_INTRO, 14, 10, 272, 20
  AUTOCHECKBOX "Browsing history", IDC_CLEAR_HISTORY, 14, 36, 272, 10
  AUTOCHECKBOX "Download history (files on disk are kept)", IDC_CLEAR_DOWNLOADS, 14, 52, 272, 10
  AUTOCHECKBOX "Cookies and site data (signs you out of sites)", IDC_CLEAR_COOKIES, 14, 68, 272, 10
  AUTOCHECKBOX "Cached files and images", IDC_CLEAR_CACHE, 14, 84, 272, 10
  AUTOCHECKBOX "Saved tabs from the last session", IDC_CLEAR_SESSION, 14, 100, 272, 10
  AUTOCHECKBOX "Bookmarks", IDC_CLEAR_BOOKMARKS, 14, 116, 272, 10
  AUTOCHECKBOX "Per-site settings (permissions, cookies, zoom)", IDC_CLEAR_SITE_SETTINGS, 14, 132, 272, 10
  AUTOCHECKBOX "Saved passwords", IDC_CLEAR_PASSWORDS, 14, 148, 272, 10
  LTEXT "Settings, the parent PIN and the download mode are never changed here.", IDC_CLEAR_NOTE, 14, 168, 272, 20
  DEFPUSHBUTTON "Clear now", IDOK, 148, 198, 66, 14
  PUSHBUTTON "Cancel", IDCANCEL, 220, 198, 66, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 320, 686
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MTK Browser Settings"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Find a setting", IDC_SETTINGS_SEARCH_LABEL, 16, 10, 140, 10
  EDITTEXT IDC_SETTINGS_SEARCH, 16, 23, 286, 14, ES_AUTOHSCROLL
  LTEXT "", IDC_SETTINGS_SEARCH_STATUS, 16, 39, 286, 10
  LTEXT "General", IDC_SETTINGS_GENERAL_HEAD, 16, 56, 140, 10
  LTEXT "Home page", IDC_SETTINGS_HOME_LABEL, 16, 76, 270, 10
  EDITTEXT IDC_SETTINGS_HOME_PAGE, 16, 89, 286, 14, ES_AUTOHSCROLL
  LTEXT "On startup", IDC_SETTINGS_STARTUP_LABEL, 16, 116, 270, 10
  COMBOBOX IDC_SETTINGS_STARTUP, 16, 129, 286, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Website language preference", IDC_SETTINGS_LANGUAGE_LABEL, 16, 158, 270, 10
  COMBOBOX IDC_SETTINGS_LANGUAGE, 16, 171, 286, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Search engine", IDC_SETTINGS_SEARCH_ENGINE_LABEL, 16, 200, 270, 10
  COMBOBOX IDC_SETTINGS_SEARCH_ENGINE, 16, 213, 286, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Downloads", IDC_SETTINGS_DOWNLOADS_LABEL, 16, 242, 270, 10
  COMBOBOX IDC_SETTINGS_DOWNLOADS, 16, 255, 286, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  AUTOCHECKBOX "Ask where to save each file before downloading", IDC_SETTINGS_DOWNLOAD_ASK, 16, 274, 286, 10
  LTEXT "Safe downloads save only known file types. Standard downloads work like other browsers and save any file type.", IDC_SETTINGS_DOWNLOADS_NOTE, 16, 288, 286, 22
  LTEXT "Site safety, shields and SafeSearch stay enabled in both modes.", IDC_SETTINGS_SAFETY_NOTE, 16, 314, 286, 10
  LTEXT "Language preference takes effect after you restart MTK Browser.", IDC_SETTINGS_LANGUAGE_NOTE, 16, 328, 286, 10

  LTEXT "Connection", IDC_SETTINGS_CONNECTION_HEAD, 16, 346, 140, 10
  AUTOCHECKBOX "Block plain HTTP content on pages (HTTPS-only)", IDC_SETTINGS_HTTPS_ONLY, 16, 360, 286, 10
  AUTOCHECKBOX "Fingerprinting protection", IDC_SETTINGS_FINGERPRINT_PROTECTION, 16, 374, 286, 10
  LTEXT "Encrypted DNS", IDC_SETTINGS_DOH_LABEL, 16, 392, 270, 10
  COMBOBOX IDC_SETTINGS_DOH, 16, 405, 286, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Encrypted DNS and fingerprinting protection take effect after you restart MTK Browser.", IDC_SETTINGS_DOH_NOTE, 16, 424, 286, 10

  AUTOCHECKBOX "Check for signed MTK Browser updates automatically", IDC_SETTINGS_AUTO_UPDATE, 16, 442, 286, 10
  AUTOCHECKBOX "Use familiar Ctrl browser shortcuts", IDC_SETTINGS_FAMILIAR_SHORTCUTS, 16, 458, 286, 10
  AUTOCHECKBOX "Memory saver for inactive tabs (pinned tabs stay awake)", IDC_SETTINGS_MEMORY_SAVER, 16, 474, 286, 10
  AUTOCHECKBOX "Use Windows Hello before opening saved passwords", IDC_SETTINGS_WINDOWS_HELLO, 16, 490, 286, 10
  LTEXT "Parent controls", IDC_SETTINGS_PARENT_HEAD, 16, 512, 140, 10
  LTEXT "", IDC_SETTINGS_PIN_STATE, 16, 526, 190, 20
  PUSHBUTTON "Parent PIN...", IDC_SETTINGS_PIN, 212, 524, 90, 14
  LTEXT "Troubleshooting", IDC_SETTINGS_TROUBLESHOOTING_HEAD, 16, 554, 140, 10
  PUSHBUTTON "Reset settings...", IDC_SETTINGS_RESET, 16, 568, 110, 14
  LTEXT "Appearance", IDC_SETTINGS_THEME_LABEL, 16, 590, 140, 10
  COMBOBOX IDC_SETTINGS_THEME, 16, 603, 286, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  AUTOCHECKBOX "On exit, clear browsing history, finished download history and saved tabs", IDC_SETTINGS_CLEAR_ON_EXIT, 16, 628, 286, 20
  DEFPUSHBUTTON "Save", IDOK, 162, 656, 66, 14
  PUSHBUTTON "Cancel", IDCANCEL, 236, 656, 66, 14
END

IDD_USER_FILTERS DIALOGEX 0, 0, 380, 278
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Your filter rules — MTK Browser"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "One rule per line. A rule blocks any address that contains it.", IDC_FILTERS_LINE1, 14, 10, 352, 10
  LTEXT "Start a line with @@ to allow instead of block, or with # for a note.", IDC_FILTERS_LINE2, 14, 24, 352, 10
  EDITTEXT IDC_FILTERS_TEXT, 14, 40, 352, 160, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
  LTEXT "All rules are valid.", IDC_FILTERS_STATUS, 14, 206, 352, 10
  LTEXT "Your rules cannot switch off site safety, SafeSearch or adult-content blocking.", IDC_FILTERS_NOTE, 14, 222, 352, 10
  DEFPUSHBUTTON "Save", IDOK, 232, 248, 62, 14
  PUSHBUTTON "Cancel", IDCANCEL, 302, 248, 64, 14
END

